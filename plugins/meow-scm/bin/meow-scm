#!/bin/sh
# SPDX-FileCopyrightText: 2026 Andrew Vasilyev <me@retran.me>
# SPDX-License-Identifier: Apache-2.0

# Runs this unit's binary of the native tool for this machine (SPC-1080).
# Where there is none, it reports the message as unchecked, because a message
# nobody checked must never read as one that passed.

case $0 in
*/*) here=${0%/*} ;;
*) here=$(command -v "$0") && here=${here%/*} ;;
esac
system= cpu= exe=
case $(uname -s 2>/dev/null) in
Darwin) system=apple-darwin ;;
Linux) system=unknown-linux-musl ;;
MINGW* | MSYS* | CYGWIN*) system=pc-windows-msvc exe=.exe ;;
esac
case $(uname -m 2>/dev/null) in
arm64 | aarch64) cpu=aarch64 ;;
x86_64 | amd64) cpu=x86_64 ;;
esac
binary="$here/$cpu-$system/meow$exe"
if [ -n "$system" ] && [ -n "$cpu" ] && [ -f "$binary" ]; then
  [ -x "$binary" ] || chmod +x "$binary" 2>/dev/null
  exec "$binary" scm "$@"
fi

reason="no meow binary was found for this machine"
case "$1" in
convention)
  echo "meow-scm convention: unknown ($reason)"
  exit 3
  ;;
check-message)
  echo "meow-scm check-message: unchecked ($reason); the message was not checked"
  exit 3
  ;;
*)
  echo "usage: meow-scm convention | meow-scm check-message [FILE]" >&2
  exit 2
  ;;
esac
