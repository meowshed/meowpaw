#!/bin/sh
# SPDX-FileCopyrightText: 2026 Andrew Vasilyev <me@retran.me>
# SPDX-License-Identifier: Apache-2.0

# Runs this unit's binary of the native tool for this machine (SPC-1080).
# Where there is none, it reports every verb unresolved itself, because a verb
# that couldn't run must never read as passed.

case $0 in
*/*) here=${0%/*} ;;
*) here=$(command -v "$0") && here=${here%/*} ;;
esac
system= cpu= exe=
case $(uname -s 2>/dev/null) in
Darwin) system=apple-darwin ;;
Linux) system=unknown-linux-musl ;;
MINGW* | MSYS* | CYGWIN*) system=pc-windows-msvc exe=.exe ;;
esac
case $(uname -m 2>/dev/null) in
arm64 | aarch64) cpu=aarch64 ;;
x86_64 | amd64) cpu=x86_64 ;;
esac
binary="$here/$cpu-$system/meow$exe"
if [ -n "$system" ] && [ -n "$cpu" ] && [ -f "$binary" ]; then
  [ -x "$binary" ] || chmod +x "$binary" 2>/dev/null
  exec "$binary" verbs "$@"
fi

verbs="fmt lint typecheck test build"
reason="no meow binary was found for this machine, $(uname -s 2>/dev/null) on $(uname -m 2>/dev/null); reinstall the unit, which ships one for macOS, Linux and Windows on arm64 and x86_64"
case "$1" in
status)
  if [ "$2" = "--json" ]; then
    printf '{"profile": null, "profile_state": "unknown", "error": "%s", "verbs": {' "$reason"
    sep=""
    for verb in $verbs; do
      printf '%s"%s": {"state": "unresolved", "kind": "no interpreter", "detail": "%s"}' "$sep" "$verb" "$reason"
      sep=", "
    done
    printf '}, "ignored": []}\n'
  else
    for verb in $verbs; do
      printf '%-10s unresolved  no interpreter: %s\n' "$verb" "$reason"
    done
  fi
  exit 0
  ;;
run)
  shift
  if [ $# -eq 0 ]; then
    echo "meow-verbs run: name the verbs to run, from: $verbs" >&2
    exit 2
  fi
  summary=""
  for verb in "$@"; do
    printf '== %s: unresolved (no interpreter: %s), not run\n' "$verb" "$reason"
    summary="$summary${summary:+, }$verb unresolved"
  done
  printf '\nsummary: %s\n' "$summary"
  exit 3
  ;;
*)
  echo "usage: meow-verbs status [--json] | meow-verbs run <verb>..." >&2
  exit 2
  ;;
esac
