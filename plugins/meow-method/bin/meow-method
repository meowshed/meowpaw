#!/bin/sh
# SPDX-FileCopyrightText: 2026 Andrew Vasilyev <me@retran.me>
# SPDX-License-Identifier: Apache-2.0

# The record's command is `paw` (ADR-1350). This alias keeps a script calling
# the old name working for one release, and says so each time it runs.

case $0 in
*/*) here=${0%/*} ;;
*) here=$(command -v "$0") && here=${here%/*} ;;
esac
echo "meow-method: this command is now paw, and 0.31.0 removes the name meow-method; run $here/paw instead" >&2
exec "$here/paw" "$@"
