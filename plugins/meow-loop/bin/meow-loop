#!/bin/sh
# SPDX-FileCopyrightText: 2026 Andrew Vasilyev <me@retran.me>
# SPDX-License-Identifier: Apache-2.0

# Runs this unit's binary of the native tool for this machine (SPC-1080).
# Where there is none, it reports the run as unresolved and starts nothing,
# because a run nobody could start must never read as one that ended.

case $0 in
*/*) here=${0%/*} ;;
*) here=$(command -v "$0") && here=${here%/*} ;;
esac
system='' cpu='' exe=''
case $(uname -s 2>/dev/null) in
Darwin) system=apple-darwin ;;
Linux) system=unknown-linux-musl ;;
MINGW* | MSYS* | CYGWIN*) system=pc-windows-msvc exe=.exe ;;
esac
case $(uname -m 2>/dev/null) in
arm64 | aarch64) cpu=aarch64 ;;
x86_64 | amd64) cpu=x86_64 ;;
esac
binary="$here/$cpu-$system/meow$exe"
# The shared binary the core unit ships, found through the core unit's data
# directory, which the platform documents and the core unit's session start
# writes (REQ-4504). The unit's own build beside it is the fallback.
data=${CLAUDE_PLUGIN_DATA:+${CLAUDE_PLUGIN_DATA%/*}}
for core in "${data:-$HOME/.claude/plugins/data}"/meow-core-*/meow-root; do
  [ -f "$core" ] || continue
  read -r root <"$core" 2>/dev/null
  if [ -n "$root" ] && [ -f "$root/bin/$cpu-$system/meow$exe" ]; then
    binary="$root/bin/$cpu-$system/meow$exe"
    break
  fi
done
# Loaded in place from a checkout, the core unit sits beside this one.
[ -f "$binary" ] || {
  beside="$here/../../meow-core/bin/$cpu-$system/meow$exe"
  [ -f "$beside" ] && binary=$beside
}
if [ -n "$system" ] && [ -n "$cpu" ] && [ -f "$binary" ]; then
  [ -x "$binary" ] || chmod +x "$binary" 2>/dev/null
  # The binary may sit in another unit, so it is told where this unit's
  # layout is. A layout the caller named wins.
  if [ -z "$MEOW_LAYOUT" ]; then
    MEOW_LAYOUT="$here/../lib/layout.toml"
    export MEOW_LAYOUT
  fi
  exec "$binary" loop "$@"
fi

reason="no meow binary was found for this machine, $(uname -s 2>/dev/null) on $(uname -m 2>/dev/null); install meow-core, which ships the shared binary for macOS, Linux and Windows on arm64 and x86_64"
case "$1" in
guard)
  # The hook runs on every Bash command, Edit and Write, and a hook that
  # fails blocks them all, so with no binary it lets each through: a write
  # to the hash check, and a start to the refusal under CLAUDECODE.
  cat >/dev/null
  exit 0
  ;;
start)
  echo "unresolved: $reason"
  exit 3
  ;;
*)
  echo "usage: meow-loop start --prompt <file> --until verbs=<stage>[,<stage>...] --iterations <n> --budget-usd <amount> --permission-mode dontAsk [--allowed-tools <rule>]... [--plugin-dir <dir>]..." >&2
  exit 2
  ;;
esac
