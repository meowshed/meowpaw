target/
.DS_Store
node_modules/
__pycache__/

# Skills borrowed into this project while it has no plugins of its own.
# They belong to the repositories that wrote them, and the gate ignores them.
.claude/skills/
# The runner writes into the plugin it evaluates, so the pattern has to reach
# there; `evals/results/` alone is anchored to this file's own directory.
plugins/*/evals/results/
# A case that resumes a history gets the resumed session's transcript written
# beside that history, under the history's session identifier.
plugins/*/evals/*/00000000-0000-4000-8000-000000000001/
plugins/*/evals/*/00000000-0000-4000-8000-000000000001.jsonl

# The native tool: its build and the binaries each unit carries (SPC-1080)
/target/
crates/meow/target/
plugins/*/bin/*-*-*/
/dist/
