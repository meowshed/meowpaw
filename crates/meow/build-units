# Builds the one binary, with every unit's program in it, into
# plugins/meow-core/bin/<target>/, where the units' launchers find it
# (REQ-4500, SPC-1080). With no argument it builds for
# this machine, so a checkout loaded in place runs the native tool without a
# release; the release names each of the six targets in turn, all built
# under Linux: the musl targets natively, the darwin targets through
# osxcross's environment, and the windows targets through cargo-xwin.

set -e
root=$(cd "$(dirname "$0")/../.." && pwd)
target=$1
if [ -z "$target" ]; then
  case $(uname -s) in
  Darwin) system=apple-darwin ;;
  Linux) system=unknown-linux-musl ;;
  MINGW* | MSYS* | CYGWIN*) system=pc-windows-msvc ;;
  *)
    echo "build-units: no target for $(uname -s)" >&2
    exit 1
    ;;
  esac
  case $(uname -m) in
  arm64 | aarch64) cpu=aarch64 ;;
  x86_64 | amd64) cpu=x86_64 ;;
  *)
    echo "build-units: no target for $(uname -m)" >&2
    exit 1
    ;;
  esac
  target="$cpu-$system"
  built=release
else
  built=$target/release
  set -- --target "$target"
fi
case $target in
*-windows-*) exe=.exe ;;
*) exe= ;;
esac

# The core unit ships the one build, with every unit's program in it, which the
# units' launchers find through the core unit's data directory (REQ-4500).
case $target in
*-windows-msvc)
  cargo xwin build --quiet --release --manifest-path "$root/crates/meow/Cargo.toml" \
    --all-features --target-dir "$root/target/full" --target "$target"
  ;;
*)
  cargo build --quiet --release --manifest-path "$root/crates/meow/Cargo.toml" \
    --all-features --target-dir "$root/target/full" "$@"
  ;;
esac
mkdir -p "$root/plugins/meow-core/bin/$target"
rm -f "$root/plugins/meow-core/bin/$target/meow$exe"
cp "$root/target/full/$built/meow$exe" "$root/plugins/meow-core/bin/$target/meow$exe"
echo "built meow-core for $target"
