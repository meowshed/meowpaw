#!/bin/sh
# SPDX-FileCopyrightText: 2026 Andrew Vasilyev <me@retran.me>
# SPDX-License-Identifier: Apache-2.0

# Runs this unit's binary of the native tool for this machine (SPC-1080).
# Where there is none, it falls back to the meow binary the core package
# carries (ADR-2810), and where neither exists, it reports the check as
# unrun and lets the publish through, because blocking every publish for a
# missing binary would teach people to uninstall the gate (ADR-1600).

case $0 in
*/*) here=${0%/*} ;;
*) here=$(command -v "$0") && here=${here%/*} ;;
esac
system='' cpu='' exe=''
case $(uname -s 2>/dev/null) in
Darwin) system=apple-darwin ;;
Linux) system=unknown-linux-musl ;;
MINGW* | MSYS* | CYGWIN*) system=pc-windows-msvc exe=.exe ;;
esac
case $(uname -m 2>/dev/null) in
arm64 | aarch64) cpu=aarch64 ;;
x86_64 | amd64) cpu=x86_64 ;;
esac
binary="$here/$cpu-$system/meow$exe"
if [ -n "$system" ] && [ -n "$cpu" ] && [ -f "$binary" ]; then
  [ -x "$binary" ] || chmod +x "$binary" 2>/dev/null
  exec "$binary" prose "$@"
fi

# The meow binary ships with the core package (ADR-2810); where it sits
# on PATH, this wrapper runs the gate through it.
if command -v meow >/dev/null 2>&1; then
  exec meow prose "$@"
fi

cat >/dev/null 2>&1
echo "meow-prose-gate $1: unrun (no meow binary was found for this machine, $(uname -s 2>/dev/null) on $(uname -m 2>/dev/null); install @meowshed/meow-core, which carries one for macOS, Linux and Windows on arm64 and x86_64); nothing was checked"
exit 0